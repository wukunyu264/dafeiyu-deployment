# 凭据与模型配置模板
# 用法：复制成 .env（或在部署根目录放几个 txt 文件，由脚本/插件读取）
# 绝对不要把填好的真实值提交到仓库。

# ---- 对话模型（OpenAI 兼容）----
CHAT_API_BASE=https://api.deepseek.com/v1
CHAT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL=deepseek-flash

# ---- 向量嵌入（长期记忆用）----
# 本机 Ollama 示例： http://127.0.0.1:11434/v1  +  bge-m3  +  维度 1024
# 云端示例：       https://api.siliconflow.cn/v1 + BAAI/bge-m3 + 维度 1024
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

# ---- 语音合成（豆包 Seed Audio，可选）----
TTS_APP_ID=xxxxxxxx
TTS_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 账号与权限 ----
# 机器人小号（NapCat 登录用）
BOT_QQ=
# 主人（管理员 + 白名单）
OWNER_QQ=

# ---- 服务 ----
ONEBOB_WS_PORT=6199
ONEBOB_WS_TOKEN=please-use-a-random-32-char-string
WEBUI_PORT=6185
